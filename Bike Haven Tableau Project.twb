    <worksheet name='Sales by Gender and Age'>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer &amp; Geography Combined+' name='federated.0u9rj9o0ncs3d51ewr4rl0icdvo1' />
          </datasources>
          <datasource-dependencies datasource='federated.0u9rj9o0ncs3d51ewr4rl0icdvo1'>
            <column caption='Age Groups' datatype='string' name='[Calculation_1189513290930565120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    [customerage] &gt;= 35 AND [customerage] &lt;= 54 &#13;&#10;        THEN &quot;Young Adults&quot;&#13;&#10;    ELSEIF [customerage] &gt;= 55 AND [customerage] &lt;= 74&#13;&#10;        THEN &quot;Middle-Aged Adults&quot;&#13;&#10;    ELSEIF [customerage] &gt;= 75 AND [customerage] &lt;= 89&#13;&#10;        THEN &quot;Seniors&quot;&#13;&#10;    ELSE &quot;Elderly&quot;&#13;&#10;END' />
            </column>
            <column caption='Customer Age' datatype='integer' name='[customerage]' role='measure' type='quantitative' />
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;F&quot;' value='Female' />
                <alias key='&quot;M&quot;' value='Male' />
              </aliases>
            </column>
            <column-instance column='[Calculation_1189513290930565120]' derivation='None' name='[none:Calculation_1189513290930565120:nk]' pivot='key' type='nominal' />
            <column-instance column='[gender]' derivation='None' name='[none:gender:nk]' pivot='key' type='nominal' />
            <column caption='Sales' datatype='real' name='[salesamount]' role='measure' type='quantitative' />
            <column-instance column='[salesamount]' derivation='Sum' name='[sum:salesamount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[none:Calculation_1189513290930565120:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Young Adults&quot;</bucket>
              <bucket>&quot;Middle-Aged Adults&quot;</bucket>
              <bucket>&quot;Seniors&quot;</bucket>
              <bucket>&quot;Elderly&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' field='[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[none:gender:nk]' value='69' />
            <format attr='width' field='[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[none:Calculation_1189513290930565120:nk]' value='175' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='size-bar' field='[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[sum:salesamount:qk]' field-type='quantitative' max-size='1' min-size='0.005' type='centersize' />
            <encoding attr='color' field='[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[sum:salesamount:qk]' type='custom-interpolated'>
