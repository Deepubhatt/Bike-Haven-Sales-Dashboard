                                      <axis>[federated.0u9rj9o0ncs3d51ewr4rl0icdvo1].[Latitude (generated)]</axis>
                                    </node-reference>
                                  </y-coord>
                                  <page-reference />
                                  <projection name='EPSG:3857' u='11.333101086314571' v='49.564447941348206' />
                                </visual-coordinate>
                              </point>
                              <body x='-12' y='-111' />
                            </annotation>
                          </annotations>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Relation b/w Customer Income &amp; Sales' captured-sheet='Relation between Customer Income &amp; Sales' id='7' />
                    <story-point caption='Most Profitable ProductLine' captured-sheet='Most Profitable ProductLine' id='8' />
                    <story-point caption='Daily New Customers over Time' captured-sheet='Daily New Customers' id='9' />
                    <story-point caption='Total Sales over Time' captured-sheet='Total Sales over Time' id='10' />
                    <story-point caption='Total Orders over Time' captured-sheet='Total Orders over Time' id='11' />
                    <story-point caption='Top 10 Cities by Sales' captured-sheet='Top 10 Cities by Sales' id='14' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='15478' hidden='true' id='13' story-point-id='8' type-v2='text' w='86570' x='8127' y='81499'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This pie chart shows the distribution of most profitable Product Lines. </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Road Bikes lead with 46.37%</run>
            <run fontname='Segoe UI Semibold'> of the total profit, followed by Mountain Bikes at 38.91%. Touring Bikes make up 12.22%, and </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Standard/Street Bikes account for the smallest share at 2.50%</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='23942' hidden='true' id='15' story-point-id='2' type-v2='text' w='42686' x='53807' y='23700'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This histogram shows the Age Distribution of Customers. The majority are between 40 and 60 years old, with the highest counts in the </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>40-45</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>Æ </run>
            <run fontname='Segoe UI Semibold'>and</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>Æ </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>45-50 age bins</run>
            <run fontname='Segoe UI Semibold'>. The number of customers decreases significantly for ages above 65.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='18742' hidden='true' id='16' story-point-id='3' type-v2='text' w='48760' x='31908' y='21161'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This heatmap displays the Profit Margin % over 3 years. It remained stable at around 41% in 2021 and 2022, but saw a</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>Æ </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>significant increase to 57.24% in 2023</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='37727' hidden='true' id='17' story-point-id='4' type-v2='text' w='24636' x='73567' y='36155'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This bar chart for Fiscal Year shows similar results to the Annual one, where we can see that the Profit Margin % is </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>steady at 40-42% from 2019 to 2022</run>
            <run fontname='Segoe UI Semibold'>. But for the </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>3rd Quarter of 2022</run>
            <run fontname='Segoe UI Semibold'>, it took the jump to </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>55.91%</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='16082' hidden='true' id='18' story-point-id='5' type-v2='text' w='87511' x='9068' y='77146'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This bar chart shows sales distribution by occupation and marital status. </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Married people have higher sales</run>
            <run fontname='Segoe UI Semibold'> in all jobs except Manual, where single people lead with 71.98%. Among Professionals, sales are almost equal between married (49.09%) and single (50.91%) individuals.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='59250' hidden='true' id='19' story-point-id='6' type-v2='text' w='13601' x='85629' y='29988'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This map chart shows the average yearly income of the customers for all the countries. </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Australia leads</run>
            <run fontname='Segoe UI Semibold'> in terms of income, while </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>France lags</run>
            <run fontname='Segoe UI Semibold'> behind all other countries.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='49456' hidden='true' id='20' story-point-id='7' type-v2='text' w='23781' x='74679' y='38694'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This scatter plot shows the relationship between average sales and average yearly income across different countries. Most data points cluster between </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>40K-70K for yearly income</run>
            <run fontname='Segoe UI Semibold'> and </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>200-800 for sales</run>
            <run fontname='Segoe UI Semibold'>. The </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>United States has some outliers</run>
            <run fontname='Segoe UI Semibold'> with both high income and sales.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='23700' hidden='true' id='23' story-point-id='9' type-v2='text' w='39521' x='12575' y='20556'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This line chart shows the trend for number of new customers added each day, based on the date of their first purchase. We can see that their is </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>sudden spike in customers added after the start of the year 2022</run>
            <run fontname='Segoe UI Semibold'>. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='22612' hidden='true' id='24' story-point-id='10' type-v2='text' w='43713' x='11035' y='16929'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This area chart gives the overview of the total sales happend over the years. A similar pattern can be seen here too as the line chart of customer acquisition. The </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>sales has drastically increased since the early months of 2022</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='17050' hidden='true' id='25' story-point-id='11' type-v2='text' w='47733' x='10351' y='19710'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This area chart gives the overview of the total orders placed by customers over the years. Here also we can see a similar pattern. The </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>number of orders has drastically increased since the start of 2022</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='14510' id='26' story-point-id='13' type-v2='text' w='89820' x='5047' y='46433'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This heatmap shows Sales Distribution by Gender and Age Group.</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>Æ </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Young Adults lead sales</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>Æ </run>
            <run fontname='Segoe UI Semibold'>for both genders, with females slightly ahead. Middle-Aged Adults have comparable sales, while Seniors and Elderly contribute the least. Overall</run>
            <run fontcolor='#000000' fontname='Segoe UI Semibold'>, </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>Females have higher total sales than males</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9674' hidden='true' id='27' story-point-id='14' type-v2='text' w='78186' x='14286' y='87908'>
          <formatted-text>
            <run fontname='Segoe UI Semibold'>This bar chart shows the top 10 Cities with the highest Sales. It is very clear from the chart that majority of the sales happen in </run>
            <run fontcolor='#f28e2b' fontname='Segoe UI Semibold'>London</run>
            <run fontname='Segoe UI Semibold'>.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{EECDC2D9-47FF-498C-8F90-4A5D809041E3}' />
    </dashboard>
  </dashboards>
